GOOGLE_CLOUD_PROJECT=secure-gcp-deployment-fleet
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

SECURE_FLEET_ENV=development

ARTIFACT_REGISTRY_REPOSITORY=secure-fleet

CLOUD_RUN_REGION=asia-south1
# ============================================================
# Orchestrator Runtime
# ============================================================

# Local development:
# ORCHESTRATOR_URL=http://127.0.0.1:8000

# Production:
ORCHESTRATOR_URL=

ORCHESTRATOR_APP_NAME=orchestrator
ORCHESTRATOR_TIMEOUT_SECONDS=120

# Optional bearer token.
# Never commit the real value.
ORCHESTRATOR_BEARER_TOKEN=

# Execution mode:
# adk = real ADK/Vertex AI execution
# local = deterministic local E2E testing only
ORCHESTRATOR_EXECUTION_MODE=adk

# Use Google Cloud identity authentication when invoking
# a private Cloud Run Orchestrator.
ORCHESTRATOR_USE_IDENTITY_TOKEN=true
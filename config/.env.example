GOOGLE_CLOUD_PROJECT=secure-gcp-deployment-fleet
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

SECURE_FLEET_ENV=development

ARTIFACT_REGISTRY_REPOSITORY=secure-fleet

CLOUD_RUN_REGION=asia-south1

# ============================================================
# Orchestrator Runtime
# ============================================================

# Local ADK server:
# ORCHESTRATOR_URL=http://127.0.0.1:8000

# Production ADK/Cloud Run URL:
ORCHESTRATOR_URL=

# ADK application name.
ORCHESTRATOR_APP_NAME=orchestrator

# Maximum time allowed for an Orchestrator execution request.
ORCHESTRATOR_TIMEOUT_SECONDS=120

# Optional bearer token for an authenticated remote Orchestrator.
# Never commit the real token.
ORCHESTRATOR_BEARER_TOKEN=